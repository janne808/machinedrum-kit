+    void JitDspRegPool::debugStoreAll()
+    {
+        for(auto i=0; i<DspCount; ++i)
+        {
+            const auto r = static_cast<PoolReg>(i);
+            JitRegGP gp;
+            SpillReg xm;
+            const bool inGP = m_gpList.get(gp, r);
+            if(!inGP && !m_xmList.get(xm, r)) continue;
+            if(r == DspX0 || r == DspX1 || r == DspY0 || r == DspY1)
+            {
+                // Normal XY stores are destructive release operations: store1 shifts
+                // its source GP, and store01 clears dirty flags. Neither is legal for
+                // a debugger snapshot while the cached registers remain live.
+                const RegGP value(m_block), pair(m_block);
+                if(inGP) m_block.asm_().mov(r32(value), r32(gp));
+                else m_block.asm_().movq(r64(value), xm.reg);
+                m_block.asm_().and_(r32(value), asmjit::Imm(0xffffff));
+                auto& target = (r == DspX0 || r == DspX1) ? m_block.dsp().regs().x : m_block.dsp().regs().y;
+                movDspReg(r64(pair), target);
+                if(r == DspX0 || r == DspY0)
+                {
+                    m_block.asm_().shr(r64(pair), asmjit::Imm(24));
+                    m_block.asm_().shl(r64(pair), asmjit::Imm(24));
+                }
+                else
+                {
+                    m_block.asm_().and_(r64(pair), asmjit::Imm(0xffffff));
+                    m_block.asm_().shl(r64(value), asmjit::Imm(24));
+                }
+                m_block.asm_().or_(r64(pair), r64(value));
+                movDspReg(target, r64(pair));
+            }
+            else if(r == DspX || r == DspY)
+            {
+                auto& target = r == DspX ? m_block.dsp().regs().x : m_block.dsp().regs().y;
+                if(inGP) movDspReg(target, gp);
+                else movDspReg(target, xm);
+            }
+            else if(inGP) store(r, gp);
+            else store(r, xm);
+        }
+    }
 
